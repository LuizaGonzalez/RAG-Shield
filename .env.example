# Proveedor del LLM: groq (gratis, el usado en las mediciones), anthropic o mock (solo pruebas)
LLM_PROVIDER=groq
LLM_API_KEY=tu_api_key_aqui

# Opcionales. Si se dejan vacíos se usa el modelo por defecto del proveedor:
# groq -> qwen/qwen3.8-27b (también sirven openai/gpt-oss-120b y openai/gpt-oss-20b) · anthropic -> claude-3-5-haiku-latest
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=600

# Recuperación: cuántos chunks llegan al prompt
RETRIEVAL_K=6

# Correo por IMAP (opcional, solo lo usa el rol laboratorio). Lectura sin marcar como leídos.
# En Gmail u Outlook usa una "contraseña de aplicación", no la contraseña normal de la cuenta.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
